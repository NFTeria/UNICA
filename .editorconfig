# One source of truth for whitespace, so a diff never carries an editor's opinion.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sol]
indent_size = 4

[*.py]
indent_size = 4

[*.vy]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
