{
  "name": "@unica/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-neutral adapter contracts and deterministic mocks. No framework, no wallet library, no network client.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./mock": {
      "types": "./dist/src/mock/index.d.ts",
      "default": "./dist/src/mock/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@unica/protocol": "0.1.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json --dry",
    "test": "npm run build && node --test \"dist/tests/*.test.js\""
  }
}
