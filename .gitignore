CHAIN-ADVANTAGES.md
INSIDE-THE-STACK.md
IDENTITY-RULING.md
REMINDERS.md
ROUTINE-*.md
*-routine-instructions.txt
prize-watch/
snap-*.txt
sponsors/
routines/
critique/
do-not-ship/
warroom*/
war-room*/
*.bundle
NOTES.md
NOTES-*.md
TODO.md
TODO-*.md
SCRATCH*.md
*.draft.md
notes/
scratch/
tmp/
.tmp/

# ── foundry ─────────────────────────────────────────────────────────────────
out/
cache/
# lib/ is NOT ignored — the v4 toolchain is vendored as git submodules (gitlinks)
# local anvil broadcasts only; TESTNET broadcasts are committed on purpose —
# they are the day-4 proof artifact (verified address + live-fire tx)
broadcast/*/31337/
broadcast/**/dry-run/
# forge coverage / gas artefacts
lcov.info
coverage/
.gas-snapshot.local
# a deployments record that names a LOCAL chain is noise; the real one is committed
deployments/*.local.json
deployments/31337*

# ── web ─────────────────────────────────────────────────────────────────────
node_modules/
web/node_modules/
web/.next/
web/dist/
web/build/
web/.turbo/
web/.vercel/
web/.env*
!web/.env.example
*.tsbuildinfo

# ── subgraph ────────────────────────────────────────────────────────────────
integrations/graph/build/
integrations/graph/generated/
integrations/graph/node_modules/
# the Studio deploy key and query keys are secrets; the subgraph.yaml is not
integrations/graph/.graphclientrc*
integrations/graph/*.key

