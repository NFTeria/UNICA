# config/unica-v4/421614.env — Arbitrum Sepolia, UNICA v5 market stack (no ENS identity on this chain). TESTNET / NO VALUE.
# Every address below was READ from the chain on 2026-09-12 through the foundry.toml alias `arbitrum_testnet`:
# PoolManager code size 24,009 bytes; WETH symbol/decimals; USDC symbol/decimals; feed description()/decimals().

UNICA_CHAIN_ID=421614
UNICA_IS_MAINNET=false
UNICA_IS_L2=true

# ── roles: the same test EOA as Sepolia (an EOA admin is permitted on a testnet only) ───────────
UNICA_ADMIN=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
UNICA_PAUSER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
DEPLOYER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73

# ── Uniswap v4 and the pair ────────────────────────────────────────────────────────────────────
UNICA_POOL_MANAGER=0xFB3e0C6F74eB1a21CC1Da29aeC80D2Dfe6C9a317   # hookmate AddressConstants for 421614; 24,009 runtime bytes read live
UNICA_ASSET=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73          # WETH; symbol WETH, 18 decimals read live
UNICA_PAYOUT=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d         # Circle test USDC; symbol USDC, 6 decimals read live
UNICA_RATE_E18=2539640000000000000000       # demonstration rate the admin sets, from the chain's ETH/USD feed at config time
UNICA_FEE=3000
UNICA_TICK_SPACING=60

# ── Chainlink price route ─────────────────────────────────────────────────────────────────────
# Feeds verified by description() and decimals() on chain. UNICA_ASSET_MAX_AGE / UNICA_QUOTE_MAX_AGE are NOT set: each must be
# validated against the feed's published heartbeat before an oracle-on market; until then this is a DEMONSTRATION market.
UNICA_REQUIRE_ORACLE=false
UNICA_ASSET_FEED=0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165   # ETH / USD, 8 decimals, read live
UNICA_QUOTE_FEED=0x0153002d20B96532C639313c2d54c3dA09109309   # USDC / USD, 8 decimals, read live (last update ~23 h before config time)
UNICA_MAX_AGE=300
UNICA_MAX_DEVIATION_BPS=200

# ── caps, USDC base units (same shape as Sepolia) ──────────────────────────────────────────────
UNICA_MAX_PER_TX_PAYOUT=10000000
UNICA_MAX_PER_DAY_PAYOUT=25000000
UNICA_MAX_SEED_PAYOUT=5000000
UNICA_SEED_PAYOUT=4900000            # the deployer must hold 4.9 test USDC on this chain (faucet: owner gate)
UNICA_AGGREGATE_SEED_CAP=100000000

# ── confidential policy: none ────────────────────────────────────────────────────────────────
UNICA_RELEASE_TAG=unica-v5/arbitrum-sepolia-1

# ── identity: NONE. ENSv2 exists only on Ethereum Sepolia; this chain runs the market stack without
# the admission gate (the registry's own allowlist names order creators). ─────────────────────
UNICA_TERMINAL_STATUS_KEY=com.unica.terminal-status
UNICA_RENDERER_VERSION=unica-identity-svg/1
UNICA_EXTERNAL_URL_BASE=https://nfteria.github.io/unica/identity/
UNICA_FACTORY=0xA0C5cc4FC6A6446a6f532942ECb6eeeF91AE8901   # recorded from stage A at block 308176024
UNICA_REGISTRY=0x3072ab51ae34f99A8b7368643c6baC7118E8a6f9   # recorded from stage A at block 308176024
UNICA_MARKET_ID=0x347ef2afeff0218f9e4d23f205a3772f063f358e72db69225481753c329acbc7   # recorded from stage B at block 308176967
UNICA_HOOK=0x524B0B6AD8B93bC907077A474C28779d620d60c0   # recorded from stage B at block 308176967
UNICA_EXECUTOR=0x79552Ad852304D04b246a85168D562B8eE244879   # recorded from stage B at block 308176967
