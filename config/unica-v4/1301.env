# config/unica-v4/1301.env — Unichain Sepolia, UNICA v5 market stack (no ENS identity on this chain). TESTNET / NO VALUE.
# Every address below was READ from the chain on 2026-09-12 through the foundry.toml alias `unichain_testnet`:
# PoolManager code size 24,009 bytes; WETH symbol/decimals; USDC symbol/decimals; feed description()/decimals().

UNICA_CHAIN_ID=1301
UNICA_IS_MAINNET=false
UNICA_IS_L2=true

# ── roles: the same test EOA as Sepolia (an EOA admin is permitted on a testnet only) ───────────
UNICA_ADMIN=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
UNICA_PAUSER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
DEPLOYER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73

# ── Uniswap v4 and the pair ────────────────────────────────────────────────────────────────────
UNICA_POOL_MANAGER=0x00B036B58a818B1BC34d502D3fE730Db729e62AC   # hookmate AddressConstants for 1301; 24,009 runtime bytes read live
UNICA_ASSET=0x4200000000000000000000000000000000000006          # WETH; symbol WETH, 18 decimals read live
UNICA_PAYOUT=0x31d0220469e10c4E71834a79b1f276d740d3768F         # Circle test USDC; symbol USDC, 6 decimals read live
UNICA_RATE_E18=2539408364840000000000       # demonstration rate the admin sets, from the chain's ETH/USD feed at config time
UNICA_FEE=3000
UNICA_TICK_SPACING=60

# ── Chainlink price route ─────────────────────────────────────────────────────────────────────
# NO verified Chainlink feed on Unichain Sepolia at config time: the oracle route is absent by design and requireOracle stays false.
UNICA_REQUIRE_ORACLE=false
# UNICA_ASSET_FEED= (none: no Chainlink Data Feed was verified on this chain; the market is demonstration-only)
# UNICA_QUOTE_FEED= (none)
UNICA_MAX_AGE=300
UNICA_MAX_DEVIATION_BPS=200

# ── caps, USDC base units (same shape as Sepolia) ──────────────────────────────────────────────
UNICA_MAX_PER_TX_PAYOUT=10000000
UNICA_MAX_PER_DAY_PAYOUT=25000000
UNICA_MAX_SEED_PAYOUT=5000000
UNICA_SEED_PAYOUT=4900000            # the deployer must hold 4.9 test USDC on this chain (faucet: owner gate)
UNICA_AGGREGATE_SEED_CAP=100000000

# ── confidential policy: none ────────────────────────────────────────────────────────────────
UNICA_RELEASE_TAG=unica-v5/unichain-sepolia-1

# ── identity: NONE. ENSv2 exists only on Ethereum Sepolia; this chain runs the market stack without
# the admission gate (the registry's own allowlist names order creators). ─────────────────────
UNICA_TERMINAL_STATUS_KEY=com.unica.terminal-status
UNICA_RENDERER_VERSION=unica-identity-svg/1
UNICA_EXTERNAL_URL_BASE=https://nfteria.github.io/unica/identity/
