# config/unica-v4/46630.env — Robinhood Chain testnet, UNICA v5 market stack (no ENS identity on this chain). TESTNET / NO VALUE.
# Every address below was READ from the chain on 2026-09-12 through the foundry.toml alias `robinhood_testnet`:
# PoolManager code size 24,009 bytes; the CREATE2 factory holds code (69 bytes); asset and payout symbol/decimals/name read live.
# No Chainlink Data Feed exists on this chain (docs directory checked 2026-09-11; every testnet file 404), so this is a labelled
# demonstration market: requireOracle=false, allowed on a testnet only.

UNICA_CHAIN_ID=46630
UNICA_IS_MAINNET=false
UNICA_IS_L2=true

# ── roles: the same test EOA as the other four test networks (an EOA admin is permitted on a testnet only) ──
UNICA_ADMIN=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
UNICA_PAUSER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
DEPLOYER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73

# ── Uniswap v4 and the pair ────────────────────────────────────────────────────────────────────
UNICA_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951   # docs/chains/ROBINHOOD.md; 24,009 runtime bytes read live
UNICA_ASSET=0xC9f9c86933092BbbfFF3CCb4b105A4A94bf3Bd4E          # a testnet token whose symbol reads TSLA and name "Tesla" (18 decimals, read live); issued by a public testnet faucet on 2026-09-10; NOT the instrument, no value
UNICA_PAYOUT=0xfb93352698150e720Bf0A321DEf3aC98D90B9874         # uTUSD "UNICA Test Dollar (testnet, no value)", 6 decimals, src/experimental/robinhood-testnet/TestPayoutToken.sol; MINTER() = the deployer, read live. Not USDC: no Circle USDC was verified on this chain
UNICA_RATE_E18=365225000000000000000        # 365.225 test dollars per unit: the Chainlink TSLA / USD feed on OP Sepolia (0xc5Fce42cd84c89518E69AcC534b08CAe6e259514, 8 decimals) answered 36522500000 at 1789233564; a demonstration rate the admin sets
UNICA_FEE=3000
UNICA_TICK_SPACING=60

# ── Chainlink price route ─────────────────────────────────────────────────────────────────────
# NO Chainlink Data Feed on chain 46630 at config time: the oracle route is absent by design and requireOracle stays false.
# The OP Sepolia feed above is a reference read for the demonstration rate only; it is on another chain and the hook never reads it.
UNICA_REQUIRE_ORACLE=false
# UNICA_ASSET_FEED= (none: no Chainlink Data Feed exists on this chain; the market is demonstration-only)
# UNICA_QUOTE_FEED= (none)
UNICA_MAX_AGE=300
UNICA_MAX_DEVIATION_BPS=200

# ── caps, uTUSD base units (6 decimals; same shape as Sepolia) ────────────────────────────────
UNICA_MAX_PER_TX_PAYOUT=10000000
UNICA_MAX_PER_DAY_PAYOUT=25000000
UNICA_MAX_SEED_PAYOUT=5000000
UNICA_SEED_PAYOUT=4900000            # the deployer must hold 4.9 uTUSD before stage C; the deployer is the minter (make v5-mint NET=robinhood_testnet)
UNICA_AGGREGATE_SEED_CAP=100000000

# ── confidential policy: none ────────────────────────────────────────────────────────────────
UNICA_RELEASE_TAG=unica-v5/robinhood-testnet-1

# ── identity: NONE. ENSv2 exists only on Ethereum Sepolia; this chain runs the market stack without
# the admission gate (the registry's own allowlist names order creators). ─────────────────────
UNICA_TERMINAL_STATUS_KEY=com.unica.terminal-status
UNICA_RENDERER_VERSION=unica-identity-svg/1
UNICA_EXTERNAL_URL_BASE=https://nfteria.github.io/unica/identity/

# ── what a wallet on this chain may hold, beyond the pair: the other faucet testnet tokens the deployer holds (symbol, 18 decimals, ~30 each, read live 2026-09-12).
# Ticker-shaped symbols on a testnet are not the instruments; the dashboard reads each symbol and balance live and never invents one. ──
UNICA_KNOWN_TOKENS=0x1fbe1a0e43594b3455993b5de5fd0a7a266298d0,0x3b8262a63d25f0477c4dde23f83cfe22cb768c93,0x5884ad2f920c162cfbbacc88c9c51aa75ec09e02,0x71178bac73cbeb415514eb542a8995b82669778d
UNICA_FACTORY=0xfdD4468715F1d2e4242E8F58205E7699137e0Aa7   # recorded from stage A at block 118242689
UNICA_REGISTRY=0x9Cb93Ab47adB2fDac35baD6097a6cCF70A441D92   # recorded from stage A at block 118242689
UNICA_MARKET_ID=0x4c968c48e90f58a8994e40590df132568f3a7ee5991fbcf84714fa4c4008639a   # recorded from stage B at block 118242969
UNICA_HOOK=0x30396Bf4C1cEB4a513425d8c0BD6EFB1FABFA0C0   # recorded from stage B at block 118242969
UNICA_EXECUTOR=0xc84f4a8C4215Ad1162FFcCcC9DA3dA589D7DaF9a   # recorded from stage B at block 118242969

# ── public explorer (Blockscout), verified answering on 2026-09-12: a keyless source of logs and links, never a judge ──
UNICA_EXPLORER_API=https://explorer.testnet.chain.robinhood.com/api
UNICA_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
UNICA_PRODUCT_CATALOG=0xdA3E3B25C09E4C8BBc184e0D4bfC2246DD898229   # recorded from stage D at block 118365146
