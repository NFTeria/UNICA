# config/unica-v4/84532.env — Base Sepolia, UNICA v5 market stack (no ENS identity on this chain). TESTNET / NO VALUE.
# Every address below was READ from the chain on 2026-09-12 through the foundry.toml alias `base_testnet`:
# PoolManager code size 24,009 bytes; WETH symbol/decimals; USDC symbol/decimals; feed description()/decimals().

UNICA_CHAIN_ID=84532
UNICA_IS_MAINNET=false
UNICA_IS_L2=true

# ── roles: the same test EOA as Sepolia (an EOA admin is permitted on a testnet only) ───────────
UNICA_ADMIN=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
UNICA_PAUSER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
DEPLOYER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73

# ── Uniswap v4 and the pair ────────────────────────────────────────────────────────────────────
UNICA_POOL_MANAGER=0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408   # hookmate AddressConstants for 84532; 24,009 runtime bytes read live
UNICA_ASSET=0x4200000000000000000000000000000000000006          # WETH; symbol WETH, 18 decimals read live
UNICA_PAYOUT=0x036CbD53842c5426634e7929541eC2318f3dCF7e         # Circle test USDC; symbol USDC, 6 decimals read live
UNICA_RATE_E18=2539408364840000000000       # demonstration rate the admin sets, from the chain's ETH/USD feed at config time
UNICA_FEE=3000
UNICA_TICK_SPACING=60

# ── Chainlink price route ─────────────────────────────────────────────────────────────────────
# Feeds verified by description() and decimals() on chain. UNICA_ASSET_MAX_AGE / UNICA_QUOTE_MAX_AGE are NOT set: each must be
# validated against the feed's published heartbeat before an oracle-on market; until then this is a DEMONSTRATION market.
UNICA_REQUIRE_ORACLE=false
UNICA_ASSET_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1   # ETH / USD, 8 decimals, read live
UNICA_QUOTE_FEED=0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165   # USDC / USD, 8 decimals, read live
UNICA_MAX_AGE=300
UNICA_MAX_DEVIATION_BPS=200

# ── caps, USDC base units (same shape as Sepolia) ──────────────────────────────────────────────
UNICA_MAX_PER_TX_PAYOUT=10000000
UNICA_MAX_PER_DAY_PAYOUT=25000000
UNICA_MAX_SEED_PAYOUT=5000000
UNICA_SEED_PAYOUT=4900000            # the deployer must hold 4.9 test USDC on this chain (faucet: owner gate)
UNICA_AGGREGATE_SEED_CAP=100000000

# ── confidential policy: none ────────────────────────────────────────────────────────────────
UNICA_RELEASE_TAG=unica-v5/base-sepolia-1

# ── identity: NONE. ENSv2 exists only on Ethereum Sepolia; this chain runs the market stack without
# the admission gate (the registry's own allowlist names order creators). ─────────────────────
UNICA_TERMINAL_STATUS_KEY=com.unica.terminal-status
UNICA_RENDERER_VERSION=unica-identity-svg/1
UNICA_EXTERNAL_URL_BASE=https://nfteria.github.io/unica/identity/
UNICA_FACTORY=0x8437BcCd3Cd7c1BfbC4EC47d9766cAaEc12e5aa3   # recorded from stage A at block 46732051
UNICA_REGISTRY=0xA0686c76446315182e1ac7cb3Fb844d812670C53   # recorded from stage A at block 46732051
UNICA_MARKET_ID=0xc620eff48202f9439a04206b2955c6abd26bfb66a5b73f1e0b7d41f4ad03e682   # recorded from stage B at block 46732103
UNICA_HOOK=0x77D1f8d20e878305b509e44a266C0F69925ca0C0   # recorded from stage B at block 46732103
UNICA_EXECUTOR=0x89BBdF3075432542CFFd0154D707ACf9ba3a56F9   # recorded from stage B at block 46732103
