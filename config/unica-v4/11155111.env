# config/unica-v4/11155111.env — Ethereum Sepolia, the first public rehearsal of UNICA v4. NO VALUE.
# Every address below was read from the chain on 2026-09-12 (description(), decimals(), symbol(), code)
# through the foundry.toml alias `sepolia_testnet`; the source of each is named beside it.

UNICA_CHAIN_ID=11155111
UNICA_IS_MAINNET=false
UNICA_IS_L2=false

# ── roles: the owner's deployer, the same EOA that holds unica.eth on ENSv2 Sepolia ─────────────
# (script/ensv2/unica-sepolia.json `merchantOwner`; an EOA admin is permitted on a testnet only)
UNICA_ADMIN=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
UNICA_PAUSER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73
DEPLOYER=0xA121e1eF31BbF0826aa67dc01e7977e80Af58D73

# ── Uniswap v4 and the pair ────────────────────────────────────────────────────────────────────
UNICA_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543   # Uniswap deployments; 24,009 runtime bytes read live
UNICA_ASSET=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14          # WETH9 on Sepolia; symbol WETH, 18 decimals read live
UNICA_PAYOUT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238         # Circle USDC on Sepolia; symbol USDC, 6 decimals read live
UNICA_RATE_E18=2515000000000000000000                           # 2,515 USDC per WETH: the ETH/USD feed read at 1789179120; a demonstration rate the admin sets
UNICA_FEE=3000
UNICA_TICK_SPACING=60

# ── Chainlink price route ─────────────────────────────────────────────────────────────────────
# MEASURED 2026-09-12: ETH / USD (0x694AA1769357215DE4FAC081bf1f309aDC325306, 8 decimals) last updated
# 1789179120, 855 s before the read; USDC / USD (0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E, 8 decimals)
# last updated 1789143156, ~10 hours before the read.
#
# THE MAXAGE QUESTION IS ANSWERED (owner ruling of 2026-09-12, docs/unica-v4/ORACLE-FRESHNESS-O2.md).
# The adapter now judges each leg against its OWN bound and reports the ASSET leg's publish time, so
# a slow stablecoin feed no longer drags a fast asset feed past the market's ceiling. What that does
# NOT do is make these two particular numbers approved: each is a value the deployer must validate
# against the feed's published heartbeat for Sepolia before a market on these feeds goes oracle-on.
# The values below are recorded as the shape of that validation, not as its result, and the rehearsal
# still runs as a DEMONSTRATION market (requireOracle=false, allowed on a testnet only) until the
# owner signs off the two heartbeats.
UNICA_REQUIRE_ORACLE=false
UNICA_ASSET_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
UNICA_QUOTE_FEED=0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E
UNICA_ASSET_MAX_AGE=300              # ETH / USD leg; NOT YET VALIDATED against the published heartbeat
UNICA_QUOTE_MAX_AGE=86400            # USDC / USD leg; NOT YET VALIDATED against the published heartbeat
UNICA_MAX_AGE=300
UNICA_MAX_DEVIATION_BPS=200

# ── caps, USDC base units ──────────────────────────────────────────────────────────────────────
UNICA_MAX_PER_TX_PAYOUT=10000000     # $10
UNICA_MAX_PER_DAY_PAYOUT=25000000    # $25
UNICA_MAX_SEED_PAYOUT=5000000        # $5 per market, on chain
UNICA_SEED_PAYOUT=4900000            # stage C deposits 4.9 test USDC; the deployer must hold it (faucet: owner gate)
UNICA_AGGREGATE_SEED_CAP=100000000   # $100 across the registry (ruling S5)

# ── confidential policy: none for the first rehearsal (no CRE workflow exists yet) ─────────────
UNICA_RELEASE_TAG=unica-v4/sepolia-rehearsal-1

# ── identity: the ENSv2 Sepolia resolver of unica.eth, read from the ETHRegistry at block 11685000 ──
# Stage A deploys EnsV2ResolverAuthority over this resolver and TerminalAdmission behind it. The per-key
# SET_TEXT behaviour was measured on this resolver's live bytecode (test/fork/EnsV2AuthorityFork.t.sol).
# The deployment id follows the local fixture's derivation exactly: keccak256(abi.encode(chainid, the
# address the authority reads)), here the resolver; anyone can recompute it with cast.
UNICA_ENSV2_RESOLVER=0x3D2d26801632e7b13B2fa75236a634e75684988c
UNICA_ENS_DEPLOYMENT_ID=0xb21f8341b4168d56bf301fbc8f2923f2210b99ddcfd72e1fdad2113ba862bb90   # bytes32 keccak256(abi.encode(11155111, UNICA_ENSV2_RESOLVER))
UNICA_TERMINAL_STATUS_KEY=com.unica.terminal-status
UNICA_PARENT_NAME=unica.eth          # every business on this chain is a subname of it; node = cast namehash
UNICA_RENDERER_VERSION=unica-identity-svg/1
UNICA_EXTERNAL_URL_BASE=https://nfteria.github.io/unica/identity/
UNICA_FACTORY=0x49241d0f80728CDd0933a4131529b2e084D96192   # recorded from stage A at block 11690158
UNICA_REGISTRY=0x8789366A3dDd465D3bf612c914E29419d0dDAa11   # recorded from stage A at block 11690158
UNICA_IDENTITY_AUTHORITY=0xB3aCbD101b026669A5b61DBbcD13d5CAe1c8f133   # recorded from stage A at block 11690158
UNICA_ADMISSION=0x95ee6cCde9B03C8841972DB52b4cBe38e7d99399   # recorded from stage A at block 11690158
UNICA_IDENTITY_TOKEN=0xaEB244C4FE0f995403eC230683d2DC84D41157CA   # recorded from stage A at block 11690158
UNICA_MARKET_ID=0x99f138caff24fe5dbe437093bac3bf66b2605e7940887fa648e5409dddaefb93   # recorded from stage B at block 11690188
UNICA_HOOK=0x2570a593e0D24ede29eC926e0c5a88B427b9A0c0   # recorded from stage B at block 11690188
UNICA_EXECUTOR=0x36DD3d5d2dd0124331Cc3874A7bb07B3A6d48ede   # recorded from stage B at block 11690188

# ── public explorer (Blockscout), verified answering on 2026-09-12: a keyless source of logs and links, never a judge ──
UNICA_EXPLORER_API=https://eth-sepolia.blockscout.com/api
UNICA_EXPLORER_URL=https://eth-sepolia.blockscout.com
UNICA_PRODUCT_CATALOG=0xEf837110e2A60B4940E57570E5AD05f39d8C398A   # recorded from stage D at block 11691641
UNICA_DIRECT_SETTLEMENT=0x14a95db5463d27a97DF464001ec65d5DADffC88e   # recorded from stage D at block 11691641
UNICA_DIRECT_ADMISSION=0x67797F735f11D5DA4f1596bE6Dc5952DdA700539   # recorded from stage D at block 11691641
