###############################################################################
# UNICA treasury guardian — PRIVATE POLICY PARAMETERS                          #
#                                                                              #
# These are the merchant's confidential strategy inputs. In a simulation the   #
# CRE CLI reads them from a local .env; in a deployment they live in the Vault #
# DON and are released only into an attested enclave. Either way they must     #
# never be committed, and .env is gitignored.                                  #
#                                                                              #
# The values below are DEMO values for the simulation, not anyone's real        #
# strategy. Copy to .env and edit.                                             #
###############################################################################

# The merchant's floor, in settlement-token base units (USDC has 6 decimals,
# so 50000000 = 50.00 USDC). Below this, the guardian restores the reserve.
UNICA_MIN_RESERVE=50000000

# How much of any surplus above the floor may be allocated, in basis points.
# 2500 = 25% of the surplus.
UNICA_TARGET_ALLOCATION_BPS=2500

# The hard ceiling on any single action, in base units. 10000000 = 10.00 USDC.
UNICA_MAX_ACTION_UNITS=10000000

# The surplus share, in basis points of the balance, above which the guardian
# reduces exposure rather than allocating further. 6000 = 60%.
UNICA_RISK_THRESHOLD_BPS=6000

# Minimum seconds between two actions.
UNICA_COOLDOWN_SECONDS=3600
