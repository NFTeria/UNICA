{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UNICA settlement intent (PUBLIC)",
  "description": "Every field here must eventually be public for the settlement to exist on chain. Nothing private may be added to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "settlementContract",
    "hook",
    "poolManager",
    "inputToken",
    "maxInput",
    "payoutToken",
    "minOut",
    "recipient",
    "poolId",
    "deadline",
    "nonce"
  ],
  "properties": {
    "chainId": {
      "type": "integer"
    },
    "settlementContract": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "hook": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "poolManager": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "payer": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "inputToken": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "maxInput": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "payoutToken": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "minOut": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "poolId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "deadline": {
      "type": "integer"
    },
    "nonce": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "policyCommitment": {
      "type": "string"
    }
  }
}
