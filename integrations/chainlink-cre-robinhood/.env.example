# NAMES ONLY. No value appears in this file, which is why it is safe to commit.
# Copy to .env (gitignored) and set values there, or export them before `cre workflow simulate`.
#
# Each name maps 1:1 to a workflow-facing secret id in secret-names.yaml, which is the mechanism
# Chainlink documents: https://docs.chain.link/cre-templates/hello-confidential-workflows
#
# Every one of these is PRIVATE. None may appear in the workflow's public result.
UNICA_RH_QUOTE_CREDENTIAL=
UNICA_RH_MAX_DEVIATION_BPS=
UNICA_RH_MAX_QUOTE_AGE_SECONDS=
UNICA_RH_MIN_MERCHANT_OUT=
UNICA_RH_PREFERRED_VENUE=
UNICA_RH_SUBMISSION_CONFIG=
